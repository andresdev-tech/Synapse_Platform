// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ======================================================
// ROLES
// ======================================================

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  usuarios Usuarios[]

  @@map("roles")
}


// ======================================================
// TIPOS DE DOCUMENTO
// ======================================================

model TipoDocumento {
  id              Int    @id @default(autoincrement())
  sigla           String @unique
  nombre_completo String

  usuarios Usuarios[]

  @@map("tipos_documento")
}


// ======================================================
// USUARIOS
// ======================================================

model Usuarios {
  id Int @id @default(autoincrement())

  nombres   String
  apellidos String

  tipo_documento_id Int
  numero_documento  String @unique

  fecha_nacimiento DateTime?

  correo_electronico String @unique
  contrasena_hash    String

  rol_id Int

  codigo_2fa     String?
  expiracion_2fa DateTime?

  activo       Boolean   @default(true)
  ultimo_login DateTime?

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  // Relaciones principales
  rol            Rol           @relation(fields: [rol_id], references: [id])
  tipo_documento TipoDocumento @relation(fields: [tipo_documento_id], references: [id])

  // Autenticación
  sesiones             Sesion[]
  tokens_actualizacion TokenActualizacion[]
  tokens_recuperacion  TokenRecuperacionContrasena[]

  // Formación
  inscripciones     Inscripcion[]
  grupos_aprendices GrupoAprendiz[]

  // Profesores
  profesores_programas ProfesorPrograma[]

  // Asistencia
  asistencias_registradas Asistencia[] @relation("UsuarioRegistraAsistencia")

  // Asignaciones
  asignaciones_realizadas HistorialAsignacion[] @relation("UsuarioRealizaAsignacion")

  // Chatbot
  chatbot_historial ChatbotHistorial[]

  // Auditoría
  auditorias Auditoria[]

  @@index([tipo_documento_id])
  @@index([rol_id])

  @@map("usuarios")
  historialAsignacions HistorialAsignacion[]
}


// ======================================================
// SESIONES
// ======================================================

model Sesion {
  id Int @id @default(autoincrement())

  usuario_id Int

  token_sesion String @unique

  ip_direccion   String?
  navegador_info String?

  activa Boolean @default(true)

  creado_en         DateTime  @default(now())
  ultima_actividad DateTime?
  expira_en        DateTime?

  usuario Usuarios @relation(fields: [usuario_id],references: [id])

  @@index([usuario_id])

  @@map("sesiones")
}


// ======================================================
// TOKENS DE ACTUALIZACIÓN
// ======================================================

model TokenActualizacion {
  id Int @id @default(autoincrement())

  usuario_id Int

  token String @unique

  expira_en DateTime

  revocado Boolean @default(false)

  creado_en DateTime @default(now())

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])

  @@map("tokens_actualizacion")
}


// ======================================================
// TOKENS DE RECUPERACIÓN DE CONTRASEÑA
// ======================================================

model TokenRecuperacionContrasena {
  id Int @id @default(autoincrement())

  usuario_id Int

  token String @unique

  expira_en DateTime

  usado Boolean @default(false)

  creado_en DateTime @default(now())

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])

  @@map("tokens_recuperacion_contrasena")
}


// ======================================================
// PROGRAMAS
// ======================================================

model Programa {
  id Int @id @default(autoincrement())

  nombre String
  slug   String @unique

  sector String?

  estado String @default("activo")

  imagen_url String?

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  beneficios    ProgramaBeneficio[]
  requisitos    ProgramaRequisito[]
  descripciones ProgramaDescripcion[]
  horarios      ProgramaHorario[]

  inscripciones Inscripcion[]

  grupos Grupo[]

  profesores ProfesorPrograma[]

  chatbot_historial ChatbotHistorial[]

  @@map("programas")
}


// ======================================================
// BENEFICIOS DE PROGRAMAS
// ======================================================

model ProgramaBeneficio {
  id Int @id @default(autoincrement())

  programa_id Int

  beneficio String

  programa Programa @relation(fields: [programa_id], references: [id], onDelete: Cascade)

  @@index([programa_id])

  @@map("programas_beneficios")
}


// ======================================================
// REQUISITOS DE PROGRAMAS
// ======================================================

model ProgramaRequisito {
  id Int @id @default(autoincrement())

  programa_id Int

  requisito String

  programa Programa @relation(fields: [programa_id], references: [id], onDelete: Cascade)

  @@index([programa_id])

  @@map("programas_requisitos")
}


// ======================================================
// DESCRIPCIONES DE PROGRAMAS
// ======================================================

model ProgramaDescripcion {
  id Int @id @default(autoincrement())

  programa_id Int

  contenido_html String

  creado_en DateTime @default(now())

  programa Programa @relation(fields: [programa_id], references: [id], onDelete: Cascade)

  @@index([programa_id])

  @@map("programas_descripciones")
}


// ======================================================
// HORARIOS DE PROGRAMAS
// ======================================================

model ProgramaHorario {
  id Int @id @default(autoincrement())

  programa_id Int

  modalidad String
  jornada   String

  horarios_json Json?

  creado_en DateTime @default(now())

  programa Programa @relation(fields: [programa_id], references: [id], onDelete: Cascade)

  @@index([programa_id])

  @@map("programas_horarios")
}


// ======================================================
// INSCRIPCIONES
// ======================================================

model Inscripcion {
  id Int @id @default(autoincrement())

  usuario_id  Int
  programa_id Int

  estado String @default("pendiente")

  observaciones String?

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  programa Programa @relation(fields: [programa_id], references: [id])

  asistencias Asistencia[]

  @@unique([usuario_id, programa_id])

  @@index([usuario_id])
  @@index([programa_id])

  @@map("inscripciones")
}


// ======================================================
// GRUPOS
// ======================================================

model Grupo {
  id Int @id @default(autoincrement())

  programa_id Int

  numero String

  capacidad_maxima Int @default(30)
  capacidad_actual Int @default(0)

  estado String @default("activo")

  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  programa Programa @relation(fields: [programa_id], references: [id])

  aprendices GrupoAprendiz[]

  historial_asignaciones HistorialAsignacion[]

  @@unique([programa_id, numero])

  @@index([programa_id])

  @@map("grupos")
}


// ======================================================
// APRENDICES DE LOS GRUPOS
// ======================================================

model GrupoAprendiz {
  id Int @id @default(autoincrement())

  grupo_id   Int
  usuario_id Int

  fecha_asignacion DateTime @default(now())

  grupo Grupo @relation(fields: [grupo_id], references: [id])

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  @@unique([grupo_id, usuario_id])

  @@index([grupo_id])
  @@index([usuario_id])

  @@map("grupos_aprendices")
}


// ======================================================
// PROFESORES POR PROGRAMA
// ======================================================

model ProfesorPrograma {
  id Int @id @default(autoincrement())

  profesor_id Int
  programa_id Int

  profesor Usuarios @relation(fields: [profesor_id], references: [id])

  programa Programa @relation(fields: [programa_id], references: [id])

  @@unique([profesor_id, programa_id])

  @@index([profesor_id])
  @@index([programa_id])

  @@map("profesores_programas")
}


// ======================================================
// HISTORIAL DE ASIGNACIONES
// ======================================================

model HistorialAsignacion {
  id Int @id @default(autoincrement())

  grupo_id   Int
  usuario_id Int

  estado_anterior String?
  estado_nuevo    String

  razon String?

  coordinador_id Int

  fecha_cambio DateTime @default(now())

  grupo Grupo @relation(fields: [grupo_id], references: [id])

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  coordinador Usuarios @relation("UsuarioRealizaAsignacion", fields: [coordinador_id], references: [id])

  @@index([grupo_id])
  @@index([usuario_id])
  @@index([coordinador_id])

  @@map("historial_asignaciones")
}


// ======================================================
// ASISTENCIAS
// ======================================================

model Asistencia {
  id Int @id @default(autoincrement())

  inscripcion_id Int

  fecha DateTime @db.Date

  asistio Boolean @default(false)

  observacion String?

  registrado_por Int?

  creado_en DateTime @default(now())

  inscripcion Inscripcion @relation(fields: [inscripcion_id], references: [id])

  registrado Usuarios? @relation("UsuarioRegistraAsistencia", fields: [registrado_por], references: [id])

  @@unique([inscripcion_id, fecha])

  @@index([inscripcion_id])
  @@index([registrado_por])

  @@map("asistencias")
}


// ======================================================
// HISTORIAL DEL CHATBOT
// ======================================================

model ChatbotHistorial {
  id Int @id @default(autoincrement())

  usuario_id Int

  pregunta_usuario String
  respuesta_bot    String

  programa_consultado_id Int?

  tokens_consumidos Int?

  creado_en DateTime @default(now())

  usuario Usuarios @relation(fields: [usuario_id], references: [id])

  programa Programa? @relation(fields: [programa_consultado_id], references: [id])

  @@index([usuario_id])
  @@index([programa_consultado_id])

  @@map("chatbot_historial")
}


// ======================================================
// DOCUMENTOS RAG
// ======================================================

model DocumentoRag {
  id Int @id @default(autoincrement())

  titulo String
  tipo   String

  contenido String

  activo Boolean @default(true)

  creado_en DateTime @default(now())

  @@map("documentos_rag")
}


// ======================================================
// AUDITORÍAS
// ======================================================

model Auditoria {
  id Int @id @default(autoincrement())

  usuario_id Int?

  accion String
  tabla  String

  registro_id String?

  datos_anteriores Json?
  datos_nuevos     Json?

  creado_en DateTime @default(now())

  usuario Usuarios? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([tabla])
  @@index([registro_id])

  @@map("auditorias")
}