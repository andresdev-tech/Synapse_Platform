// ============================================================
// SYNAPSE V2.0 — DATABASE SCHEMA
// PostgreSQL + Prisma + pgvector
// ===========================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  USER
}

enum DomainScope {
  USER
  ADMIN
  ALL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
  DELETED
}

enum ContentType {
  ANNOUNCEMENT
  NEWS
  EVENT
  INFORMATION
  RESOURCE
}

enum Visibility {
  PUBLIC
  AUTHENTICATED
  PRIVATE
}

enum ResourceType {
  IMAGE
  VIDEO
  DOCUMENT
  PDF
  LINK
  OTHER
}

enum ReactionType {
  LIKE
  LOVE
  USEFUL
  IMPORTANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  ROLE_CHANGE
  STATUS_CHANGE
}

// ============================================================
// SESSION
// ============================================================

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ============================================================
// VERIFICATION CODE / OTP
// ============================================================

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([email, code])
}

// ============================================================
// USER
// ============================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String?    @db.VarChar(255)
  email         String     @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?
  status        UserStatus @default(PENDING)

  roleId String? @db.Uuid

  layoutPrefs Json?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  sessions Session[]

  preferences UserPreference[]

  contents Content[] @relation("ContentAuthor")

  comments Comment[]

  reactions Reaction[]

  resources Resource[]

  auditLogs AuditLog[]

  @@index([roleId])
  @@index([status])
  @@index([email])
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// ============================================================
// USER PREFERENCES
// ============================================================

model UserPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  key   String @db.VarChar(100)
  value Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ============================================================
// CONTENT
// ============================================================

model Content {
  id String @id @default(uuid()) @db.Uuid

  title   String  @db.VarChar(255)
  slug    String  @unique @db.VarChar(255)
  section String? @db.VarChar(100)
  excerpt String?
  body    String

  type       ContentType
  status     ContentStatus @default(DRAFT)
  visibility Visibility    @default(PUBLIC)

  featured Boolean @default(false)
  isGlobal Boolean @default(false)

  authorId   String  @db.Uuid
  categoryId String? @db.Uuid

  publishedAt DateTime?
  scheduledAt DateTime?
  expiresAt   DateTime?

  viewCount Int @default(0)

  seoTitle       String? @db.VarChar(255)
  seoDescription String?
  seoImage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  comments Comment[]

  reactions Reaction[]

  resources ContentResource[]

  documentChunks DocumentChunk[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([visibility])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@index([featured])
  @@index([isGlobal])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String?
  imageUrl    String?
  color       String? @db.VarChar(50)

  parentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Category[] @relation("CategoryHierarchy")

  contents Content[]

  @@index([parentId])
  @@index([slug])
}

// ============================================================
// COMMENT
// ============================================================

model Comment {
  id String @id @default(uuid()) @db.Uuid

  content String

  contentId String  @db.Uuid
  authorId  String  @db.Uuid
  parentId  String? @db.Uuid

  approved Boolean @default(true)
  deleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentRef Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([contentId])
  @@index([authorId])
  @@index([parentId])
  @@index([approved])
  @@index([deleted])
}

// ============================================================
// REACTION
// ============================================================

model Reaction {
  id String @id @default(uuid()) @db.Uuid

  type ReactionType

  userId    String @db.Uuid
  contentId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ============================================================
// RESOURCE / FILE
// ============================================================

model Resource {
  id String @id @default(uuid()) @db.Uuid

  name String       @db.VarChar(255)
  url  String
  type ResourceType

  mimeType String? @db.VarChar(100)
  size     BigInt?
  altText  String?

  uploadedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  contents ContentResource[]

  documentChunks DocumentChunk[]

  @@index([uploadedById])
  @@index([type])
}

// ============================================================
// CONTENT ↔ RESOURCE
// ============================================================

model ContentResource {
  contentId  String @db.Uuid
  resourceId String @db.Uuid

  position Int     @default(0)
  caption  String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([contentId, resourceId])
  @@index([contentId])
  @@index([resourceId])
}

// ============================================================
// DOCUMENT CHUNK / RAG
// ============================================================

model DocumentChunk {
  id String @id @default(uuid()) @db.Uuid

  content String

  embedding Unsupported("vector(1024)")

  chunkIndex Int

  resourceId String? @db.Uuid
  contentId  String? @db.Uuid

  createdAt DateTime @default(now())

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  contentRef Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([contentId])
  @@index([chunkIndex])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @db.Uuid

  action AuditAction

  entity   String  @db.VarChar(100)
  entityId String? @db.Uuid

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================================
// ALLOWED DOMAINS
// ============================================================

model AllowedDomain {
  id          String      @id @default(uuid()) @db.Uuid
  domain      String      @unique @db.VarChar(120)
  scope       DomainScope @default(USER)
  isActive    Boolean     @default(true)
  description String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([domain, isActive])
}
