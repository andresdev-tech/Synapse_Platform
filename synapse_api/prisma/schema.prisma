generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model auditoria {
  id               Int       @id @default(autoincrement())
  usuario_id       Int?
  accion           String
  tabla            String
  registro_id      String?
  datos_anteriores Json?
  datos_nuevos     Json?
  creado_en        DateTime  @default(now())
  usuarios         usuarios? @relation(fields: [usuario_id], references: [id])
}

model chatbot_historial {
  id                     Int        @id @default(autoincrement())
  usuario_id             Int
  pregunta_usuario       String
  respuesta_bot          String
  programa_consultado_id Int?
  tokens_consumidos      Int?
  creado_en              DateTime   @default(now())
  programas              programas? @relation(fields: [programa_consultado_id], references: [id])
  usuarios               usuarios   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model documentos_rag {
  id        Int      @id @default(autoincrement())
  titulo    String
  tipo      String
  contenido String
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())
}

model inscripciones {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  programa_id    Int
  estado         String    @default("pendiente")
  observaciones  String?
  creado_en      DateTime  @default(now())
  actualizado_en DateTime?
  programas      programas @relation(fields: [programa_id], references: [id], onDelete: Cascade)
  usuarios       usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String
  expira_en  DateTime
  usado      Boolean  @default(false)
  creado_en  DateTime @default(now())
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model programas {
  id                      Int                       @id @default(autoincrement())
  nombre                  String
  slug                    String                    @unique
  sector                  String?
  estado                  String                    @default("activo")
  imagen_url              String?
  creado_en               DateTime                  @default(now())
  actualizado_en          DateTime?
  chatbot_historial       chatbot_historial[]
  inscripciones           inscripciones[]
  programas_beneficios    programas_beneficios[]
  programas_descripciones programas_descripciones[]
  programas_horarios      programas_horarios[]
  programas_requisitos    programas_requisitos[]
}

model programas_beneficios {
  id          Int       @id @default(autoincrement())
  programa_id Int
  beneficio   String
  programas   programas @relation(fields: [programa_id], references: [id], onDelete: Cascade)
}

model programas_descripciones {
  id             Int       @id @default(autoincrement())
  programa_id    Int
  contenido_html String
  creado_en      DateTime  @default(now())
  programas      programas @relation(fields: [programa_id], references: [id], onDelete: Cascade)
}

model programas_horarios {
  id            Int       @id @default(autoincrement())
  programa_id   Int
  modalidad     String
  jornada       String
  horarios_json Json?
  creado_en     DateTime  @default(now())
  programas     programas @relation(fields: [programa_id], references: [id], onDelete: Cascade)
}

model programas_requisitos {
  id          Int       @id @default(autoincrement())
  programa_id Int
  requisito   String
  programas   programas @relation(fields: [programa_id], references: [id], onDelete: Cascade)
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String
  expira_en  DateTime
  revocado   Boolean  @default(false)
  creado_en  DateTime @default(now())
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model roles {
  id          Int        @id @default(autoincrement())
  nombre_rol  String     @unique
  descripcion String?
  usuarios    usuarios[]
}

model sesiones {
  id               Int       @id @default(autoincrement())
  usuario_id       Int
  token_sesion     String
  ip_direccion     String?
  navegador_info   String?
  es_activa        Boolean   @default(true)
  creado_en        DateTime  @default(now())
  ultima_actividad DateTime?
  expira_en        DateTime?
  usuarios         usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model tipos_documento {
  id              Int        @id @default(autoincrement())
  sigla           String     @unique
  nombre_completo String
  usuarios        usuarios[]
}

model usuarios {
  id                    Int                     @id @default(autoincrement())
  nombres               String
  apellidos             String
  tipo_documento_id     Int
  numero_documento      String                  @unique
  fecha_nacimiento      DateTime?               @db.Date
  correo_electronico    String                  @unique
  password_hash         String
  rol_id                Int
  activo                Boolean                 @default(true)
  ultimo_login          DateTime?
  creado_en             DateTime                @default(now())
  actualizado_en        DateTime?
  auditoria             auditoria[]
  chatbot_historial     chatbot_historial[]
  inscripciones         inscripciones[]
  password_reset_tokens password_reset_tokens[]
  refresh_tokens        refresh_tokens[]
  sesiones              sesiones[]
  roles                 roles                   @relation(fields: [rol_id], references: [id])
  tipos_documento       tipos_documento         @relation(fields: [tipo_documento_id], references: [id])
}
